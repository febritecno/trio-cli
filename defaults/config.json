{
  "targets": {
    "claude": {
      "enabled": true,
      "scope": "user",
      "setDefault": true
    },
    "opencode": {
      "enabled": true,
      "scope": "user",
      "setDefault": false
    },
    "cursor": {
      "enabled": false,
      "scope": "user"
    },
    "copilot": {
      "enabled": false,
      "scope": "user"
    },
    "gemini": {
      "enabled": false,
      "scope": "user"
    },
    "droid": {
      "enabled": false,
      "scope": "user"
    },
    "kilo": {
      "enabled": false,
      "scope": "user"
    },
    "codex": {
      "enabled": false,
      "scope": "user"
    }
  },
  "roles": {
    "builder": {
      "name": "conductor",
      "description": "Runs the session and writes the code. Delegates exploration to scout and consults advisor at key decisions.",
      "prompt": "prompts/builder.md",
      "models": {
        "claude": "sonnet",
        "opencode": "opencode/claude-sonnet-5-5",
        "cursor": "inherit",
        "copilot": "inherit",
        "gemini": "inherit",
        "droid": "inherit",
        "kilo": "inherit",
        "codex": "inherit"
      }
    },
    "scout": {
      "name": "scout",
      "description": "Fast, cheap read-only explorer. Use for locating code, reading files, tracing call paths, and looking up documentation. Launch several in parallel, one per independent question. Does not edit files or make design decisions.",
      "prompt": "prompts/scout.md",
      "models": {
        "claude": "haiku",
        "opencode": "opencode/claude-haiku-5-5",
        "cursor": "inherit",
        "copilot": "inherit",
        "gemini": "inherit",
        "droid": "inherit",
        "kilo": "inherit",
        "codex": "inherit"
      },
      "frontmatter": {
        "claude": {
          "tools": "Read, Grep, Glob, WebFetch, WebSearch"
        },
        "opencode": {
          "permission": {
            "edit": "deny",
            "bash": "deny"
          }
        },
        "cursor": {
          "readonly": true
        },
        "copilot": {
          "tools": [
            "read",
            "search",
            "web"
          ]
        },
        "droid": {
          "tools": [
            "Read",
            "LS",
            "Grep",
            "Glob",
            "WebSearch",
            "FetchUrl"
          ]
        },
        "kilo": {
          "permission": {
            "edit": "deny",
            "bash": "deny"
          }
        },
        "codex": {
          "sandbox_mode": "read-only"
        }
      }
    },
    "advisor": {
      "name": "advisor",
      "description": "Senior reviewer for high-stakes moments only. Use to review a plan before a large or hard-to-reverse change, to get unstuck after the same error has survived two fix attempts, and for a final check before declaring a non-trivial task done. Not for routine edits, lookups, or exploration.",
      "prompt": "prompts/advisor.md",
      "models": {
        "claude": "opus",
        "opencode": "opencode/claude-opus-5-5",
        "cursor": "inherit",
        "copilot": "inherit",
        "gemini": "inherit",
        "droid": "inherit",
        "kilo": "inherit",
        "codex": "inherit"
      },
      "frontmatter": {
        "claude": {
          "tools": "Read, Grep, Glob, Bash"
        },
        "opencode": {
          "permission": {
            "edit": "deny"
          }
        },
        "cursor": {
          "readonly": true
        },
        "copilot": {
          "tools": [
            "read",
            "search",
            "execute"
          ]
        },
        "droid": {
          "tools": [
            "Read",
            "LS",
            "Grep",
            "Glob",
            "Execute"
          ]
        },
        "kilo": {
          "permission": {
            "edit": "deny"
          }
        },
        "codex": {
          "sandbox_mode": "read-only"
        }
      }
    }
  }
}
